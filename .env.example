# Copy to .env and edit. Everything works with the defaults (no keys needed).

# Quiz generator backend: none (curated question bank) | hf (Hugging Face Transformers) | ollama
EDUADAPT_LLM=none
EDUADAPT_HF_MODEL=ibm-granite/granite-3.3-2b-instruct
EDUADAPT_OLLAMA_URL=http://localhost:11434
EDUADAPT_OLLAMA_MODEL=granite3.3:2b

# Hindi translation of generated text: none | hf
EDUADAPT_TRANSLATE=none
EDUADAPT_TRANSLATE_MODEL=Helsinki-NLP/opus-mt-en-hi

# Speech: stt = none | whisper ; tts = gtts | none
EDUADAPT_STT=none
EDUADAPT_WHISPER_MODEL=base
EDUADAPT_TTS=gtts
